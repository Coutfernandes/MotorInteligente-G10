# LLM
GOOGLE_API_KEY=sua_chave_gemini_aqui
# gemini = IA real | simulado = respostas fixas, sem chave e sem cota (só para testar a interface)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# OCI Object Storage
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=./oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_BUCKET_NAME=communitylab-ativos-marketing
OCI_NAMESPACE=

# App
APP_ENV=development
LOG_LEVEL=INFO
